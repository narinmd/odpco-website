generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

model User{
  id          String         @id       @default(cuid())
  name        String?
  email       String        @unique
  password    String
  createdAt   DateTime    @default(now())
}

model ContactManagement {
  id        String   @id @default(cuid())
  email     String?
  phone     String? 
  mobile    String?  
  fax       String?  
  address   String?  
  
  updatedAt DateTime @updatedAt
}